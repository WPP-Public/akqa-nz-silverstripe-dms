{
    "name": "heyday/silverstripe-dms",
    "description": "Adds a Document Management System to SilverStripe ",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "dms",
        "document",
        "document management system"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Julian Seidenberg",
            "email": "julian@silverstripe.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/cms": "^6",
        "silverstripe/asset-admin": "^3",
        "silverstripe/taxonomy": "^4",
        "symbiote/silverstripe-gridfieldextensions": "^5"
    },
    "suggest": {
        "undefinedoffset/sortablegridfield": "Allow documents to be reordered via drag-and-drop"
    },
    "extra": {
        "branch-alias": {
            "dev-silverstripe-6": "3.x-dev"
        },
        "expose": [
            "client"
        ]
    },
    "autoload": {
        "psr-4": {
            "Sunnysideup\\DMS\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
